Header set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"

# ══════════════════════════════════════════════════════════════════════
# ONE SHARED ITINERARY TEMPLATE
# Every itinerary now resolves to trip.php, which renders new-trip-v2.html.
# Legacy baked .html URLs are kept only as redirects so old bookmarks still work.
# This means Itinerary, Bookings, Map and Budget all come from the same template.
# ══════════════════════════════════════════════════════════════════════
<IfModule mod_rewrite.c>
RewriteEngine On

# Serve the Trips dashboard through trips.php so dashboard presentation fixes
# are applied server-side before the page reaches the browser.
RewriteRule ^trips/?$ trips.php [L,QSA]
RewriteRule ^trips/index\.html$ /trips/ [R=302,L,QSA]

# Retired share page.
RewriteRule ^share\.html$ /new-trip-v2.html [R=301,L,QSA]

# Legacy baked itinerary URLs -> canonical dynamic trip URL.
# Match both root copies and /trips/ copies created by older deploys.
RewriteRule ^(?:trips/)?china\.html$ /china-2026 [R=302,L,QSA]
RewriteRule ^(?:trips/)?dubai\.html$ /dubai-2025 [R=302,L,QSA]
RewriteRule ^(?:trips/)?costa-rica\.html$ /costa-rica-2025 [R=302,L,QSA]
RewriteRule ^(?:trips/)?canada\.html$ /canada-2027 [R=302,L,QSA]
RewriteRule ^(?:trips/)?hong-kong-taiwan\.html$ /hk-taiwan-2027 [R=302,L,QSA]
RewriteRule ^(?:trips/)?porto-2026\.html$ /porto-2026 [R=302,L,QSA]
RewriteRule ^(?:trips/)?hamburg\.html$ /hamburg [R=302,L,QSA]
RewriteRule ^(?:trips/)?porto-v2\.html$ /porto-2026-v2 [R=302,L,QSA]
RewriteRule ^(?:trips/)?porto-budget\.html$ /porto-2026-v2 [R=302,L,QSA]
RewriteRule ^(?:trips/)?graz-ljubljana-lake-bled-2027\.html$ /graz-ljubljana-lake-bled-2027 [R=302,L,QSA]

# Canonical itinerary route. A clean trip slug always uses the dynamic renderer.
# Files/directories such as /trips/, /icons/ and /api.php continue to work normally.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-z0-9-]+)/?$ trip.php?slug=$1 [L,QSA]
</IfModule>

# Browser caching for static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/javascript        "access plus 7 days"
  ExpiresByType text/css               "access plus 7 days"
  ExpiresByType image/png              "access plus 30 days"
  ExpiresByType image/jpeg             "access plus 30 days"
  ExpiresByType image/webp             "access plus 30 days"
  ExpiresByType image/x-icon           "access plus 1 year"
  ExpiresByType image/svg+xml          "access plus 30 days"
  ExpiresByType font/woff2             "access plus 1 year"
  ExpiresByType font/woff              "access plus 1 year"
</IfModule>

# auth.js carries small shared behaviour fixes used by the Trips dashboard.
# Do not let a week-long JS cache hide newly deployed fixes.
<Files "auth.js">
  Header set Cache-Control "no-cache, no-store, must-revalidate"
  Header set Pragma "no-cache"
  Header set Expires "0"
</Files>

# Prevent itinerary HTML from being cached (trip data changes frequently)
<FilesMatch "\.html$">
  Header set Cache-Control "no-cache, must-revalidate"
</FilesMatch>

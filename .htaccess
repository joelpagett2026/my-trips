Header set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"

# Dynamic v2 trip pages — clean-URL trips (e.g. /porto-2027) with no real
# file or directory on disk are routed to trip.php, which renders them
# fresh from new-trip-v2.html + the DB on every request. Existing baked
# .html trips (real files) are left completely alone and win by default.
<IfModule mod_rewrite.c>
RewriteEngine On

# share.html was retired — old share links already carry ?t=TOKEN&share=1,
# so a redirect straight to new-trip-v2.html (which now handles read-only
# share views itself) keeps any previously-shared links working.
RewriteRule ^share\.html$ /new-trip-v2.html [R=301,L,QSA]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-z0-9-]+)/?$ trip.php?slug=$1 [L,QSA]
</IfModule>

# Browser caching for static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/javascript        "access plus 7 days"
  ExpiresByType text/css               "access plus 7 days"
  ExpiresByType image/png              "access plus 30 days"
  ExpiresByType image/jpeg             "access plus 30 days"
  ExpiresByType image/webp             "access plus 30 days"
  ExpiresByType image/x-icon           "access plus 1 year"
  ExpiresByType image/svg+xml          "access plus 30 days"
  ExpiresByType font/woff2             "access plus 1 year"
  ExpiresByType font/woff              "access plus 1 year"
</IfModule>

# Prevent HTML pages from being cached (data changes frequently)
<FilesMatch "\.html$">
  Header set Cache-Control "no-cache, must-revalidate"
</FilesMatch>

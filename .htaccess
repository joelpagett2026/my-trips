Header set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Permissions-Policy "camera=(), microphone=(), payment=(), usb=()"

# HSTS starts with a deliberately short one-day pilot. Do not add includeSubDomains
# or preload until the canonical host and any intended subdomains have completed a
# longer compatibility period. Browsers ignore this header on plain HTTP responses.
Header always set Strict-Transport-Security "max-age=86400"

# CSP is deliberately layered. Keep the first structural policy stable because it
# is already production-proven, then enforce additional low-risk directives in a
# second policy. Multiple CSP response headers are cumulative in browsers.
Header always set Content-Security-Policy "base-uri 'self'; object-src 'none'; frame-ancestors 'self'"
Header always add Content-Security-Policy "form-action 'self'; manifest-src 'self'; worker-src 'self' blob:; media-src 'self' data: blob:"

# Script/style/network restrictions remain report-only while inline handlers and
# browser integrations are migrated. Nominatim is an audited dashboard geocoding
# fallback alongside Google Maps and Photon/Komoot.
Header always set Content-Security-Policy-Report-Only "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' 'unsafe-inline' https://maps.googleapis.com https://maps.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://maps.googleapis.com https://maps.gstatic.com https://photon.komoot.io https://nominatim.openstreetmap.org; worker-src 'self' blob:; manifest-src 'self'; media-src 'self' data: blob:; frame-src 'self' https://www.google.com https://maps.google.com"

# ══════════════════════════════════════════════════════════════════════
# SHARED RENDERERS
# Itineraries use trip.php + new-trip-v2.html. The raw shared template is never
# served directly because it contains compatibility source that must be sanitized
# and runtime browser configuration that must be injected server-side.
# ══════════════════════════════════════════════════════════════════════
<IfModule mod_rewrite.c>
RewriteEngine On

# template-runtime.php is server-only except for one explicit derivative asset:
# the sanitized, versioned itinerary engine used by authenticated trip pages.
# Bare/direct helper requests remain forbidden by the rule immediately below.
RewriteCond %{QUERY_STRING} (^|&)asset=itinerary-core(&|$) [NC]
RewriteRule ^template-runtime\.php$ - [L]

# Server-only include/configuration files live in public_html because the PHP
# endpoints require them locally, but they are not browser endpoints. Block direct
# HTTP execution even if one of them would otherwise produce an empty response.
# Internal PHP require/include calls bypass mod_rewrite and continue to work.
RewriteRule ^(?:db-config|auth-session|template-runtime|secrets)\.php$ - [F,L]

# Render the homepage through a small PHP shell so critical auth/database assets
# always receive fresh version URLs after a security deployment. Do not allow the
# raw source template to be requested directly and bypass those runtime fixes.
RewriteRule ^index\.html$ / [R=302,L,QSA]
RewriteRule ^$ home.php [L,QSA]

RewriteRule ^trips/index\.html$ /trips/ [R=302,L,QSA]
RewriteRule ^share\.html$ /share.php [R=302,L,QSA]

# The V1 editor is retired. Even if a stale copy remains in public_html from an
# older deployment, it must never be executable or reachable again.
RewriteRule ^new-trip\.html$ - [R=410,L]

# Browser API traffic is same-origin only. Block explicit cross-site fetches and
# reject foreign Origin headers before authentication/rate-limit code runs. CLI
# requests without browser Origin/Sec-Fetch-Site headers remain available for
# controlled administration with a valid bearer/deploy credential.
RewriteCond %{HTTP:Sec-Fetch-Site} ^cross-site$ [NC]
RewriteRule ^(?:api|auth-v2|record|record-delete|trip-create|trip-delete|place-photo|backup-export)\.php$ - [F,L]
RewriteCond %{HTTP:Origin} !^$
RewriteCond %{HTTP:Origin} !^https://(?:www\.)?joelpagett\.co\.uk$ [NC]
RewriteRule ^(?:api|auth-v2|record|record-delete|trip-create|trip-delete|place-photo|backup-export)\.php$ - [F,L]

# Intercept historical place-photo API actions before api.php executes. The
# dedicated endpoint resolves Google's public image URL server-side so the
# server Places key never appears in browser JSON or an <img> URL.
RewriteCond %{QUERY_STRING} (^|&)action=(place_photo_v2|place_photo)(&|$) [NC]
RewriteRule ^api\.php$ place-photo.php [L,QSA]

# Public share data must pass through share.php so each token's booking-reference
# privacy choice is enforced server-side. This also preserves compatibility with
# older cached clients that still call api.php?action=share_load directly.
RewriteCond %{QUERY_STRING} (^|&)action=share_load(&|$) [NC]
RewriteRule ^api\.php$ share.php [L,QSA]

# Generic record deletion remains available to non-trip tools, but it must pass
# through a guard that protects the registry, snapshots and active trip records.
RewriteCond %{QUERY_STRING} (^|&)action=delete(&|$) [NC]
RewriteRule ^api\.php$ record-delete.php [L,QSA]

# Legacy whole-record writes bypass the conflict-safe record.php endpoint,
# generic setting writes bypass the dedicated PIN/session lifecycle, and the old
# create_page action could create/overwrite a trip separately from its registry
# entry. All three are superseded by dedicated safe endpoints.
RewriteCond %{QUERY_STRING} (^|&)action=(save|set_setting|create_page)(&|$) [NC]
RewriteRule ^api\.php$ - [R=410,L]

# Existing share links used /new-trip-v2.html?share=1&t=TOKEN. Preserve them by
# internally handing them to share.php, then deny every other direct template hit.
RewriteCond %{QUERY_STRING} (^|&)share=1(&|$) [NC]
RewriteRule ^new-trip-v2\.html$ share.php [L,QSA]
RewriteRule ^new-trip-v2\.html$ - [R=404,L]

# Settings uses a tiny renderer so Settings-only runtime modules stay out of
# auth.js/db.js while settings.html remains the presentation source.
RewriteRule ^settings\.html$ settings.php [L,QSA]
RewriteRule ^settings/?$ settings.php [L,QSA]

# Public pages that need a browser Maps key are rendered through PHP so the key
# can be centrally restricted/rotated without committing the active value again.
RewriteRule ^trips/?$ trips.php [L,QSA]
RewriteRule ^parks/map\.html$ parks-map.php [L,QSA]

RewriteRule ^(?:trips/)?hong-kong-taiwan\.html$ /hk-taiwan-2027 [R=302,L,QSA]
RewriteRule ^(?:trips/)?porto-2026\.html$ /porto-2026 [R=302,L,QSA]
RewriteRule ^(?:trips/)?porto-v2\.html$ /porto-2026 [R=302,L,QSA]
RewriteRule ^(?:trips/)?porto-budget\.html$ /porto-2026 [R=302,L,QSA]
RewriteRule ^porto-2026-v2/?$ /porto-2026 [R=302,L,QSA]
RewriteRule ^(?:trips/)?graz-ljubljana-lake-bled-2027\.html$ /graz-ljubljana-lake-bled-2027 [R=302,L,QSA]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-z0-9-]+)/?$ trip.php?slug=$1 [L,QSA]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "^(api|auth-v2|record|record-delete|trip-create|trip-delete|place-photo|backup-export)\.php$">
    Header always unset Access-Control-Allow-Origin
    Header always unset Access-Control-Allow-Credentials
  </FilesMatch>
</IfModule>

# Compress the large itinerary HTML/CSS/JS payloads and JSON responses at the
# origin. CDNs and browsers negotiate Content-Encoding automatically; binary
# images are deliberately excluded because recompressing them wastes CPU.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/manifest+json text/xml application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/javascript        "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType text/css               "access plus 7 days"
  ExpiresByType image/png              "access plus 30 days"
  ExpiresByType image/jpeg             "access plus 30 days"
  ExpiresByType image/webp             "access plus 30 days"
  ExpiresByType image/x-icon           "access plus 1 year"
  ExpiresByType image/svg+xml          "access plus 30 days"
  ExpiresByType font/woff2             "access plus 1 year"
  ExpiresByType font/woff              "access plus 1 year"
</IfModule>

# Application overrides that do not yet receive deployment-specific URLs stay
# revalidated so presentation changes cannot linger behind an old browser copy.
<FilesMatch "^(?:trip-dashboard-create|budget-live-redesign)\.js$">
  Header set Cache-Control "no-cache, must-revalidate"
</FilesMatch>

# These assets receive file-modification versions from the PHP renderers, so a
# deployment automatically creates a new URL whenever the file changes. Long-term
# immutable caching then makes repeat itinerary loads effectively local for them.
<FilesMatch "^(?:auth|db|map-mobile-redesign|itinerary-completion|itinerary-state-guard|itinerary-ui|mobile-drag|trip-delete|trip-standalone|trip-drawer-swipe|trip-mobile-modal-layout)\.js$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
<FilesMatch "^itinerary-v2-style\.css$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

# Other static assets still benefit from normal browser caching, while remaining
# easy to refresh if a fixed version string is reused elsewhere on the site.
<FilesMatch "\.(?:png|jpe?g|webp|svg|ico|woff2?|webmanifest)$">
  Header set Cache-Control "public, max-age=2592000, stale-while-revalidate=86400"
</FilesMatch>

<FilesMatch "\.html$">
  Header set Cache-Control "no-cache, must-revalidate"
</FilesMatch>

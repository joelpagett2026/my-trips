Header set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"

# ══════════════════════════════════════════════════════════════════════
# SHARED RENDERERS
# Itineraries use trip.php + new-trip-v2.html. The raw shared template is never
# served directly because it contains compatibility source that must be sanitized
# and runtime browser configuration that must be injected server-side.
# ══════════════════════════════════════════════════════════════════════
<IfModule mod_rewrite.c>
RewriteEngine On

RewriteRule ^trips/index\.html$ /trips/ [R=302,L,QSA]
RewriteRule ^share\.html$ /share.php [R=302,L,QSA]

# Legacy whole-record writes bypass the conflict-safe record.php endpoint, and
# generic setting writes could bypass the dedicated PIN/session lifecycle. No
# current browser code uses either action, so fail them closed at the web edge.
RewriteCond %{QUERY_STRING} (^|&)action=(save|set_setting)(&|$) [NC]
RewriteRule ^api\.php$ - [R=410,L]

# Existing share links used /new-trip-v2.html?share=1&t=TOKEN. Preserve them by
# internally handing them to share.php, then deny every other direct template hit.
RewriteCond %{QUERY_STRING} (^|&)share=1(&|$) [NC]
RewriteRule ^new-trip-v2\.html$ share.php [L,QSA]
RewriteRule ^new-trip-v2\.html$ - [R=404,L]

# Public pages that need a browser Maps key are rendered through PHP so the key
# can be centrally restricted/rotated without committing the active value again.
RewriteRule ^trips/?$ trips.php [L,QSA]
RewriteRule ^parks/map\.html$ parks-map.php [L,QSA]

RewriteRule ^(?:trips/)?hong-kong-taiwan\.html$ /hk-taiwan-2027 [R=302,L,QSA]
RewriteRule ^(?:trips/)?porto-2026\.html$ /porto-2026 [R=302,L,QSA]
RewriteRule ^(?:trips/)?porto-v2\.html$ /porto-2026 [R=302,L,QSA]
RewriteRule ^(?:trips/)?porto-budget\.html$ /porto-2026 [R=302,L,QSA]
RewriteRule ^porto-2026-v2/?$ /porto-2026 [R=302,L,QSA]
RewriteRule ^(?:trips/)?graz-ljubljana-lake-bled-2027\.html$ /graz-ljubljana-lake-bled-2027 [R=302,L,QSA]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-z0-9-]+)/?$ trip.php?slug=$1 [L,QSA]
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/javascript        "access plus 7 days"
  ExpiresByType text/css               "access plus 7 days"
  ExpiresByType image/png              "access plus 30 days"
  ExpiresByType image/jpeg             "access plus 30 days"
  ExpiresByType image/webp             "access plus 30 days"
  ExpiresByType image/x-icon           "access plus 1 year"
  ExpiresByType image/svg+xml          "access plus 30 days"
  ExpiresByType font/woff2             "access plus 1 year"
  ExpiresByType font/woff              "access plus 1 year"
</IfModule>

# Critical application behaviour changes frequently. These scripts control
# authentication, record saving, conflict protection and itinerary presentation,
# so never allow the generic seven-day JavaScript expiry to hide a new version.
<FilesMatch "^(auth|db|itinerary-state-guard|itinerary-ui|budget-live-redesign|datepicker)\.js$">
  Header set Cache-Control "no-cache, no-store, must-revalidate"
  Header set Pragma "no-cache"
  Header set Expires "0"
</FilesMatch>

<FilesMatch "\.html$">
  Header set Cache-Control "no-cache, must-revalidate"
</FilesMatch>

Header set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"

# ══════════════════════════════════════════════════════════════════════
# ONE SHARED ITINERARY TEMPLATE
# Every itinerary now resolves to trip.php, which renders new-trip-v2.html.
# Legacy baked .html URLs are kept only as redirects so old bookmarks still work.
# This means Itinerary, Bookings, Map and Budget all come from the same template.
# ══════════════════════════════════════════════════════════════════════
<IfModule mod_rewrite.c>
RewriteEngine On

RewriteRule ^trips/index\.html$ /trips/ [R=302,L,QSA]
RewriteRule ^share\.html$ /new-trip-v2.html [R=301,L,QSA]

RewriteRule ^(?:trips/)?hong-kong-taiwan\.html$ /hk-taiwan-2027 [R=302,L,QSA]
RewriteRule ^(?:trips/)?porto-2026\.html$ /porto-2026 [R=302,L,QSA]
RewriteRule ^(?:trips/)?porto-v2\.html$ /porto-2026 [R=302,L,QSA]
RewriteRule ^(?:trips/)?porto-budget\.html$ /porto-2026 [R=302,L,QSA]
RewriteRule ^porto-2026-v2/?$ /porto-2026 [R=302,L,QSA]
RewriteRule ^(?:trips/)?graz-ljubljana-lake-bled-2027\.html$ /graz-ljubljana-lake-bled-2027 [R=302,L,QSA]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-z0-9-]+)/?$ trip.php?slug=$1 [L,QSA]
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/javascript        "access plus 7 days"
  ExpiresByType text/css               "access plus 7 days"
  ExpiresByType image/png              "access plus 30 days"
  ExpiresByType image/jpeg             "access plus 30 days"
  ExpiresByType image/webp             "access plus 30 days"
  ExpiresByType image/x-icon           "access plus 1 year"
  ExpiresByType image/svg+xml          "access plus 30 days"
  ExpiresByType font/woff2             "access plus 1 year"
  ExpiresByType font/woff              "access plus 1 year"
</IfModule>

# Critical application behaviour changes frequently. These scripts control
# authentication, record saving, conflict protection and itinerary presentation,
# so never allow the generic seven-day JavaScript expiry to hide a new version.
<FilesMatch "^(auth|db|itinerary-state-guard|itinerary-ui|budget-live-redesign|datepicker)\.js$">
  Header set Cache-Control "no-cache, no-store, must-revalidate"
  Header set Pragma "no-cache"
  Header set Expires "0"
</FilesMatch>

<FilesMatch "\.html$">
  Header set Cache-Control "no-cache, must-revalidate"
</FilesMatch>
